# ─── App ────────────────────────────────────────────────
APP_NAME=versace-hrms
APP_ENV=development
DEBUG=true
SECRET_KEY=generate-a-long-random-key-for-production
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (Local PostgreSQL) ────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/hrms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ─── Auth bootstrap (development only) ────────────────
CREATE_DEFAULT_SUPER_ADMIN=true
DEFAULT_SUPER_ADMIN_EMAIL=admin@versace.com
DEFAULT_SUPER_ADMIN_PASSWORD=admin@1234
DEFAULT_SUPER_ADMIN_FIRST_NAME=Super
DEFAULT_SUPER_ADMIN_LAST_NAME=Admin

# ─── Email ──────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_key_here
EMAIL_FROM=noreply@versace-hrms.com
EMAIL_FROM_NAME=Versace HRMS

# ─── Storage ────────────────────────────────────────────
STORAGE_BACKEND=LOCAL
LOCAL_STORAGE_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ─── Frontend ───────────────────────────────────────────
# Backend URL (Port 8080)
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_APP_NAME=Versace HRMS

# ─── Postgres (for local dev reference) ────────────────
POSTGRES_DB=hrms_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_passwordPOSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# ─── pgAdmin ────────────────────────────────────────────
PGADMIN_EMAIL=admin@hrms.local
PGADMIN_PASSWORD=admin
