# ─── App ────────────────────────────────────────────────
APP_NAME=versace-hrms
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hrms:hrms_password@postgres:5432/hrms_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ─── Email ──────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_key_here
EMAIL_FROM=noreply@versace-hrms.com
EMAIL_FROM_NAME=Versace HRMS

# ─── Storage ────────────────────────────────────────────
# LOCAL | S3
STORAGE_BACKEND=LOCAL
LOCAL_STORAGE_PATH=/app/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=Versace HRMS

# ─── Postgres (Docker Compose) ──────────────────────────
POSTGRES_DB=hrms_db
POSTGRES_USER=hrms
POSTGRES_PASSWORD=hrms_password

# ─── pgAdmin ────────────────────────────────────────────
PGADMIN_EMAIL=admin@hrms.local
PGADMIN_PASSWORD=admin
